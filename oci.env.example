# OCI Configuration
OCI_CONFIG=/home/ubuntu/oracle-freetier-instance-creation/oci_config
OCI_COMPARTMENT_ID=
MICRO_AD=AD-1
# Fixed by code; this fork refuses any other shape.
OCI_COMPUTE_SHAPE=VM.Standard.E2.1.Micro
REQUEST_WAIT_TIME_SECS=120
SSH_AUTHORIZED_KEYS_FILE=/home/ubuntu/oracle-freetier-instance-creation/id_rsa.pub
MICRO_SSH_PUBLIC_KEY=/home/ubuntu/oracle-freetier-instance-creation/id_rsa.pub
# Regional subnet OCID. Required for micro_hunter.py even on an OCI instance.
OCI_SUBNET_ID=
OCI_IMAGE_ID=
# The following will be ignored if OCI_IMAGE_ID is specified
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION=22.04
ASSIGN_PUBLIC_IP=true
# Boot volume size in GB (minimum is 50)
BOOT_VOLUME_SIZE=50

# Sequential Micro hunter safety limits
MICRO_NAME_PREFIX=micro
MAX_RUNTIME_HOURS=6
MAX_LAUNCH_ATTEMPTS=180
MAX_BACKOFF_SECS=900
MAX_RATE_LIMIT_FAILURES=5
RECONCILE_GRACE_SECS=180
MAX_TOTAL_BLOCK_VOLUME_GB=200

# Gmail Notification
NOTIFY_EMAIL=False
EMAIL=
EMAIL_PASSWORD=

# Discord Notification (optional)
DISCORD_WEBHOOK=

# Telegram Notification (optional)
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
